[Unit]
Description=Agentic OS - Userspace Sandwich Layer
Documentation=https://github.com/agentic-os/agentic-os
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 ~/.agentic-os/core/main.py
WorkingDirectory=%h/.agentic-os
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=AGENTIC_OS_CONFIG=%h/.agentic-os/config.yaml

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.agentic-os

# Cgroup integration
Slice=user.slice

[Install]
WantedBy=default.target
